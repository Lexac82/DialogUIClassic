<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.blizzard.com/wow/ui/">
    <Frame name="DQuestFramePanelTemplate" virtual="true">
        <Size>
            <AbsDimension x="612" y="612" />
        </Size>
        <Anchors>
            <Anchor point="TOPLEFT" />
		</Anchors>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture file="Interface\AddOns\DialogUIClassic\src\assets\art\parchment\Parchment">
                    <Size x="612" y="612" />
                </Texture>
            </Layer>
        </Layers>
    </Frame>
    <!-- TODO properly change the DQuestItemTemplate and  DQuestRewardItemTemplate -->
    <Button name="DQuestItemTemplate" virtual="true">
        <Size>
            <AbsDimension x="240" y="50" />
        </Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentBackground" file="Interface\AddOns\DialogUIClassic\src\assets\art\parchment\RewardChoice-Pending">
                    <Size>
                        <AbsDimension x="240" y="50" />
                    </Size>
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="0" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
                <Texture name="$parentNameFrame" file="">
                    <Size>
                        <AbsDimension x="240" y="50" />
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentIconTexture" relativePoint="RIGHT">
                            <Offset>
                                <AbsDimension x="-10" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture name="$parentIconTexture">
                    <Size>
                        <AbsDimension x="35" y="35" />
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT">
                            <Offset>
                                <AbsDimension x="9" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString name="$parentName" inherits="DGameFontHighlight" justifyH="LEFT">
                    <Size>
                        <AbsDimension x="170" y="36" />
                    </Size>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentBackground">
                            <Offset>
                                <AbsDimension x="53" y="0" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
            <Layer level="ARTWORK">
                <FontString name="$parentCount" inherits="NumberFontNormal" justifyH="RIGHT">
                    <Anchors>
                        <Anchor point="BOTTOMRIGHT" relativeTo="$parentIconTexture">
                            <Offset>
                                <AbsDimension x="-4" y="1" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
        <Scripts>
            <OnLoad>
                this.hasItem = 1;
            </OnLoad>
            <OnEnter>
                if ( this:GetAlpha() > 0 ) then
                GameTooltip:SetOwner(this, "ANCHOR_RIGHT");
                if ( this.rewardType == "item" ) then
                GameTooltip:SetQuestItem(this.type, this:GetID());
                elseif ( this.rewardType == "spell" ) then
                GameTooltip:SetQuestRewardSpell();
                end
                end
                CursorUpdate();
            </OnEnter>
            <OnLeave>
                GameTooltip:Hide();
                ResetCursor();
            </OnLeave>
            <OnUpdate>
                CursorOnUpdate();
            </OnUpdate>
            <OnClick>
                QuestItem_OnClick();
            </OnClick>
        </Scripts>
    </Button>
    <Button name="DQuestRewardItemTemplate" inherits="DQuestItemTemplate" virtual="true">
        <Scripts>
            <OnClick>
                DQuestRewardItem_OnClick();
            </OnClick>
        </Scripts>
    </Button>
    <Button name="DQuestTitleButtonTemplate" virtual="true">
        <Size>
            <AbsDimension x="470" y="20" />
        </Size>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture name="$parentQuestIcon" file="Interface\AddOns\DialogUIClassic\src\assets\art\icons\availableQuestIcon">
                    <Size>
                        <AbsDimension x="20" y="20" />
                    </Size>
                    <Anchors>
                        <Anchor point="TOPLEFT">
                            <Offset>
                                <AbsDimension x="10" y="-5" />
                            </Offset>
                        </Anchor>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
        <Scripts>
            <OnClick>
            DQuestTitleButton_OnClick();
        </OnClick>
        </Scripts>
        <HighlightTexture
        file="Interface\AddOns\DialogUIClassic\src\assets\art\parchment\ButtonHighlight-Gossip"
        alphaMode="ADD" />
        <ButtonText>
            <Size>
                <AbsDimension x="375" y="0" />
            </Size>
            <Anchors>
                <Anchor point="TOPLEFT">
                    <Offset>
                        <!-- controls the text inside of greeting panel  -->
                        <AbsDimension x="30" y="-7" />
                    </Offset>
                </Anchor>
            </Anchors>
        </ButtonText>
        <NormalFont inherits="DQuestButtonTitleGossip" justifyH="LEFT">
            <Anchors>
                <Anchor point="LEFT">
                    <Offset>
                        <AbsDimension x="20" y="0" />
                    </Offset>
                </Anchor>
            </Anchors>
        </NormalFont>
    </Button>
</Ui>
